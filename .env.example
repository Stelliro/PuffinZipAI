# ============================================================================
#  PuffinZipAI — Local Environment Configuration
# ============================================================================
#  Copy this file to `.env` and edit the values below.
#  `.env` is git-ignored — your secrets stay local.
#
#  start.sh automatically loads `.env` before launching the server.
# ============================================================================

# ── Admin / Remote-Access Credentials ────────────────────────────────────────
# A secondary login for remote access (e.g. stelliro.com/puffinzipai).
# Both MUST be set to enable the admin login.  The auto-generated primary
# credentials still work alongside these.
# PUFFIN_ADMIN_USERNAME=MyAdminUser
# PUFFIN_ADMIN_PASSWORD=MySuperSecretPassword123

# ── Primary Credential Overrides (optional) ─────────────────────────────────
# Override the auto-generated credentials.  All three must be set together.
# PUFFIN_USERNAME=
# PUFFIN_PASSWORD=
# PUFFIN_SECRET_KEY=

# ── Server Settings ─────────────────────────────────────────────────────────
# PUFFIN_PORT=5001
# PUFFIN_HOST=               # blank = auto-detect from public_access setting
# PUFFIN_PUBLIC_ACCESS=true  # true = bind 0.0.0.0, false = 127.0.0.1

# ── Custom URL (informational — shown in startup banner) ────────────────────
# PUFFIN_CUSTOM_URL=https://stelliro.com/puffinzipai

# ── Hardware / Performance ──────────────────────────────────────────────────
# PUFFIN_WORKERS=0            # 0 = auto-detect
# PUFFIN_GPUS=                # comma-separated GPU IDs, blank = all
# PUFFIN_CACHE_MAX_MB=200
# PUFFIN_CACHE_MAX_FILES=500

# ── GitHub ──────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=               # Optional — higher API rate limits

# ── Repo (for fresh-clone mode) ─────────────────────────────────────────────
# PUFFIN_REPO_URL=https://github.com/Stelliro/PuffinZipAI.git
# PUFFIN_REPO_BRANCH=main
